# Variables de entorno del sistema de gestion
#
# COPIÁ este archivo como ".env.local" (no se sube a git, es lo correcto).
#
#   cp .env.example .env.local
#
# Los valores los encontrás en el panel de Supabase:
#   Project Settings -> API -> Project URL y Publishable key
#
# Si no creás el archivo, el proyecto igual funciona: la app tiene estos
# valores como alternativa por defecto (ver lib/supabase.ts).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=